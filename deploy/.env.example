# --- urls ---
# services' origins for the browser; empty is the page's own, behind a proxy
# PUBLIC_API_URL=http://localhost:3000
# PUBLIC_LSP_URL=ws://localhost:3001

# origins the services accept, comma separated
# CORS_ORIGIN=http://localhost:8080


# --- backend ---
# LOG_LEVEL=info
# EMPTY_ROOM_TTL_SECONDS=60
# RECONNECT_GRACE_SECONDS=10
# MAX_PLAYERS_PER_ROOM=20
# MAX_ROOMS=1000
# PISTON_TIMEOUT_SECONDS=60
# MAX_CODE_LENGTH=64000
# MAX_CONCURRENT_RUNS=16
# ENABLED_LANGUAGES=python,javascript,typescript,go,java,c,cpp,rust


# --- lsp ---
# required, shared by backend and lsp: openssl rand -hex 32
LSP_SECRET=
# LSP_LOG_LEVEL=info
# LSP_MAX_SESSIONS=16
# LSP_MAX_SESSIONS_PER_PLAYER=2
# LSP_IDLE_TIMEOUT_SECONDS=600
# LSP_MEMORY_LIMIT=8g


# --- redis ---
# container limit
# REDIS_MEMORY_LIMIT=512m


# --- piston ---
# piston limits, in ms and bytes
# PISTON_RUN_TIMEOUT=3000
# PISTON_RUN_CPU_TIME=3000
# PISTON_COMPILE_TIMEOUT=20000
# PISTON_COMPILE_CPU_TIME=20000
# PISTON_RUN_MEMORY_LIMIT=512000000
# PISTON_COMPILE_MEMORY_LIMIT=1024000000
# PISTON_OUTPUT_MAX_SIZE=65536
# PISTON_MAX_CONCURRENT_JOBS=8
