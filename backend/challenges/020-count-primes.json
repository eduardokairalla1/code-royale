{
  "id": "count-primes",
  "title": "Counting primes",
  "description": "Read N and print how many prime numbers are less than or equal to N.\n\nConstraints: 1 ≤ N ≤ 10^6",
  "difficulty": "medium",
  "timeLimitSeconds": 600,
  "examples": [
    { "input": "10", "output": "4" },
    { "input": "30", "output": "10" }
  ],
  "tests": [
    { "input": "1", "output": "0" },
    { "input": "2", "output": "1" },
    { "input": "3", "output": "2" },
    { "input": "100", "output": "25" },
    { "input": "1000", "output": "168" },
    { "input": "7919", "output": "1000" },
    { "input": "99991", "output": "9592" },
    { "input": "500000", "output": "41538" },
    { "input": "1000000", "output": "78498" }
  ]
}
