{
  "id": "digit-sum",
  "title": "Sum of digits",
  "description": "Read a non-negative integer N and print the sum of its digits.\n\nConstraints: 0 ≤ N ≤ 10^9",
  "difficulty": "easy",
  "timeLimitSeconds": 300,
  "examples": [
    { "input": "123", "output": "6" },
    { "input": "9005", "output": "14" }
  ],
  "tests": [
    { "input": "0", "output": "0" },
    { "input": "7", "output": "7" },
    { "input": "10", "output": "1" },
    { "input": "999999999", "output": "81" },
    { "input": "1000000000", "output": "1" },
    { "input": "101010", "output": "3" },
    { "input": "48213", "output": "18" }
  ]
}
