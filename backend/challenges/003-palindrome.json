{
  "id": "palindrome",
  "title": "Palindrome",
  "description": "Read a lowercase word and print YES if it reads the same backwards, or NO otherwise.\n\nConstraints: 1 ≤ length ≤ 1000",
  "difficulty": "easy",
  "timeLimitSeconds": 900,
  "examples": [
    { "input": "racecar", "output": "YES" },
    { "input": "code", "output": "NO" },
    { "input": "a", "output": "YES" }
  ],
  "tests": [
    { "input": "abba", "output": "YES" },
    { "input": "abca", "output": "NO" },
    { "input": "level", "output": "YES" },
    { "input": "ab", "output": "NO" },
    { "input": "aa", "output": "YES" },
    { "input": "abcdcba", "output": "YES" },
    { "input": "abcdba", "output": "NO" },
    { "input": "", "output": "YES" },
    { "input": "", "output": "YES" },
    { "input": "", "output": "NO" },
    { "input": "", "output": "NO" }
  ]
}
