{
  "id": "gcd-lcm",
  "title": "GCD and LCM",
  "description": "Read two positive integers A and B from a single line and print their greatest common divisor and their least common multiple, separated by a space.\n\nConstraints: 1 ≤ A, B ≤ 10^6",
  "difficulty": "easy",
  "timeLimitSeconds": 300,
  "examples": [
    { "input": "12 18", "output": "6 36" },
    { "input": "7 5", "output": "1 35" }
  ],
  "tests": [
    { "input": "1 1", "output": "1 1" },
    { "input": "6 6", "output": "6 6" },
    { "input": "1 1000000", "output": "1 1000000" },
    { "input": "17 34", "output": "17 34" },
    { "input": "100 75", "output": "25 300" },
    { "input": "999983 999979", "output": "1 999962000357" },
    { "input": "1000000 999999", "output": "1 999999000000" },
    { "input": "462 1071", "output": "21 23562" }
  ]
}
