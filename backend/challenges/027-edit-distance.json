{
  "id": "edit-distance",
  "title": "Edit distance",
  "description": "Read two lowercase words, one per line. Print the smallest number of single letter insertions, deletions or replacements that turn the first word into the second.\n\nConstraints: 1 ≤ length of each word ≤ 1000",
  "difficulty": "hard",
  "timeLimitSeconds": 900,
  "examples": [
    { "input": "kitten\nsitting", "output": "3" },
    { "input": "flaw\nlawn", "output": "2" }
  ],
  "tests": [
    { "input": "a\na", "output": "0" },
    { "input": "a\nb", "output": "1" },
    { "input": "abc\nabc", "output": "0" },
    { "input": "abc\nxyz", "output": "3" },
    { "input": "a\naaaaa", "output": "4" },
    { "input": "intention\nexecution", "output": "5" },
    { "input": "sunday\nsaturday", "output": "3" },
    { "input": "\", "output": "513" },
    { "input": "\nb", "output": "1000" },
    { "input": "\", "output": "511" }
  ]
}
