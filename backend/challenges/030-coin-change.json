{
  "id": "coin-change",
  "title": "Coin change",
  "description": "The first line has N and a value V. The second line has the N coin values. Using as many coins of each value as you want, print the smallest number of coins that add up to exactly V, or -1 if it is not possible.\n\nConstraints: 1 ≤ N ≤ 100, 1 ≤ each coin ≤ 10^4, 0 ≤ V ≤ 10^4",
  "difficulty": "hard",
  "timeLimitSeconds": 900,
  "examples": [
    { "input": "3 11\n1 2 5", "output": "3" },
    { "input": "1 3\n2", "output": "-1" }
  ],
  "tests": [
