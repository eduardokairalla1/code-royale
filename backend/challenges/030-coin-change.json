    { "input": "3 6\n1 3 4", "output": "2" },
    { "input": "2 7\n2 4", "output": "-1" },
    { "input": "3 30\n1 10 25", "output": "3" },
    { "input": "1 10000\n1", "output": "10000" },
    { "input": "2 9999\n2 10000", "output": "-1" },
    { "input": "4 63\n1 5 10 21", "output": "3" },
