{
  "id": "anagram",
  "title": "Anagrams",
  "description": "Read two lowercase words from a single line and print YES if one is an anagram of the other (same letters, same amounts, any order), or NO otherwise.\n\nConstraints: 1 ≤ length of each word ≤ 1000",
  "difficulty": "easy",
  "timeLimitSeconds": 300,
  "examples": [
    { "input": "listen silent", "output": "YES" },
    { "input": "hello world", "output": "NO" }
  ],
  "tests": [
    { "input": "a a", "output": "YES" },
    { "input": "ab ba", "output": "YES" },
    { "input": "aab abb", "output": "NO" },
    { "input": "abc abcd", "output": "NO" },
    { "input": "evil vile", "output": "YES" },
    { "input": "aabbcc abcabc", "output": "YES" },
    { "input": "aaa aa", "output": "NO" },
    { "input": "night thing", "output": "YES" },
    { "input": " ", "output": "YES" },
    { "input": " ", "output": "NO" }
  ]
}
