{
  "id": "longest-palindrome",
  "title": "Longest palindromic substring",
  "description": "Read a lowercase word and print the length of its longest contiguous part that reads the same backwards.\n\nConstraints: 1 ≤ length ≤ 1000",
  "difficulty": "hard",
  "timeLimitSeconds": 900,
  "examples": [
    { "input": "babad", "output": "3" },
    { "input": "abacdfgdcaba", "output": "3" }
  ],
  "tests": [
    { "input": "a", "output": "1" },
    { "input": "ab", "output": "1" },
    { "input": "aa", "output": "2" },
    { "input": "racecar", "output": "7" },
    { "input": "forgeeksskeegfor", "output": "10" },
    { "input": "abcde", "output": "1" },
    { "input": "", "output": "1000" },
    { "input": "", "output": "22" },
    { "input": "", "output": "9" },
    { "input": "", "output": "11" }
  ]
}
