{
  "id": "run-length",
  "title": "Run-length encoding",
  "description": "Read a string of lowercase letters and compress it: replace every run of the same letter by the letter followed by the size of the run.\n\nConstraints: 1 ≤ length ≤ 10^4",
  "difficulty": "medium",
  "timeLimitSeconds": 600,
  "examples": [
    { "input": "aaabcc", "output": "a3b1c2" },
    { "input": "abc", "output": "a1b1c1" }
  ],
  "tests": [
    { "input": "a", "output": "a1" },
    { "input": "aaaaaaaaaaaa", "output": "a12" },
    { "input": "abab", "output": "a1b1a1b1" },
    { "input": "zzzzzyz", "output": "z5y1z1" },
    { "input": "", "output": "a10000" },
    { "input": "aabbbccccddddd", "output": "a2b3c4d5" },
    { "input": "", "output": "" },
    { "input": "", "output": "" }
  ]
}
