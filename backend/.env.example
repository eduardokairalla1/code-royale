# general
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# security: allowed frontend origins, comma separated
CORS_ORIGIN=http://localhost:5173

# rooms
EMPTY_ROOM_TTL_SECONDS=60
RECONNECT_GRACE_SECONDS=10
MAX_PLAYERS_PER_ROOM=20
MAX_ROOMS=1000

# challenges: defaults to backend/challenges
# CHALLENGES_DIR=./challenges

# code execution
PISTON_URL=http://localhost:2000
PISTON_TIMEOUT_SECONDS=60
MAX_CODE_LENGTH=64000
MAX_CONCURRENT_RUNS=16

# languages players may pick, comma separated; all of them when unset
# ENABLED_LANGUAGES=python,javascript,typescript,go,java,c,cpp,rust

# rooms, rounds and timers; required, shared by every instance
REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=code-royale:

# shared with the lsp service, 32+ chars; unset turns autocomplete off
# LSP_SECRET=
# LSP_TICKET_TTL_SECONDS=60
